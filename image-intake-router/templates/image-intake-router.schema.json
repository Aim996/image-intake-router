{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.openclaw.invalid/schemas/image-intake-router.v3.json",
  "title": "Image Intake Router v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_id",
    "preview_state",
    "source",
    "recognition_run",
    "cleaned_text",
    "facts",
    "accounting_content",
    "inventory_content",
    "warnings",
    "handoff"
  ],
  "properties": {
    "schema_version": { "const": "image-intake-router.v3" },
    "preview_id": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "preview_state": { "enum": ["awaiting_confirmation", "handed_off", "not_actionable", "failed"] },
    "source": { "$ref": "#/$defs/source" },
    "recognition_run": { "$ref": "#/$defs/recognitionRun" },
    "cleaned_text": { "type": ["string", "null"], "minLength": 1, "maxLength": 20000 },
    "facts": { "$ref": "#/$defs/facts" },
    "accounting_content": { "oneOf": [{ "$ref": "#/$defs/accountingContent" }, { "type": "null" }] },
    "inventory_content": { "oneOf": [{ "$ref": "#/$defs/inventoryContent" }, { "type": "null" }] },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 100 },
    "handoff": { "oneOf": [{ "$ref": "#/$defs/handoff" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "preview_state": { "const": "awaiting_confirmation" }
        },
        "required": ["preview_state"]
      },
      "then": {
        "properties": {
          "handoff": { "type": "null" }
        },
        "anyOf": [
          { "properties": { "accounting_content": { "type": "object", "properties": { "executable": { "const": true } }, "required": ["executable"] } } },
          { "properties": { "inventory_content": { "type": "object", "properties": { "executable": { "const": true } }, "required": ["executable"] } } }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "preview_state": { "const": "handed_off" }
        },
        "required": ["preview_state"]
      },
      "then": {
        "properties": { "handoff": { "$ref": "#/$defs/handoff" } }
      }
    },
    {
      "if": {
        "properties": {
          "handoff": {
            "type": "object",
            "properties": {
              "selected_scopes": { "contains": { "const": "accounting" }, "minContains": 1 }
            },
            "required": ["selected_scopes"]
          }
        },
        "required": ["handoff"]
      },
      "then": {
        "properties": {
          "accounting_content": {
            "type": "object",
            "properties": { "executable": { "const": true } },
            "required": ["executable"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "handoff": {
            "type": "object",
            "properties": {
              "selected_scopes": { "contains": { "const": "inventory" }, "minContains": 1 }
            },
            "required": ["selected_scopes"]
          }
        },
        "required": ["handoff"]
      },
      "then": {
        "properties": {
          "inventory_content": {
            "type": "object",
            "properties": { "executable": { "const": true } },
            "required": ["executable"]
          }
        }
      }
    },
    {
      "if": { "properties": { "preview_state": { "const": "not_actionable" } }, "required": ["preview_state"] },
      "then": {
        "properties": {
          "accounting_content": { "oneOf": [{ "type": "null" }, { "type": "object", "properties": { "executable": { "const": false } }, "required": ["executable"] }] },
          "inventory_content": { "oneOf": [{ "type": "null" }, { "type": "object", "properties": { "executable": { "const": false } }, "required": ["executable"] }] },
          "handoff": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "preview_state": { "const": "failed" } }, "required": ["preview_state"] },
      "then": {
        "properties": {
          "recognition_run": { "properties": { "status": { "enum": ["failed", "not_executed"] } }, "required": ["status"] },
          "cleaned_text": { "type": "null" },
          "accounting_content": { "type": "null" },
          "inventory_content": { "type": "null" },
          "warnings": { "minItems": 1 },
          "handoff": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "recognition_run": { "properties": { "status": { "enum": ["failed", "not_executed"] } }, "required": ["status"] } },
        "required": ["recognition_run"]
      },
      "then": {
        "properties": {
          "preview_state": { "const": "failed" },
          "cleaned_text": { "type": "null" },
          "accounting_content": { "type": "null" },
          "inventory_content": { "type": "null" },
          "warnings": { "minItems": 1 },
          "handoff": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_count", "has_user_text"],
      "properties": {
        "image_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "has_user_text": { "type": "boolean" }
      }
    },
    "recognitionRun": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mandatory runtime validation: attachment_count equals source.image_count and attachments.length; attachments contain exactly one record for each unique contiguous attachment_index from 0 through attachment_count - 1; processed_attachment_count equals the number of attachments whose status is not not_executed and must not exceed attachment_count. A succeeded run requires processed_attachment_count to equal attachment_count. Fail closed before any preview or handoff when any invariant is violated.",
      "required": ["status", "method", "pass_count", "refinement", "attachment_count", "processed_attachment_count", "attachments", "issues"],
      "properties": {
        "status": { "enum": ["succeeded", "partial", "failed", "not_executed"] },
        "method": { "enum": ["native_vision", "media_understanding"] },
        "pass_count": { "type": "integer", "minimum": 0, "maximum": 2 },
        "refinement": { "$ref": "#/$defs/refinementRun" },
        "attachment_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "processed_attachment_count": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Derived from attachment records that entered visual capability (not not_executed). Runtime validation requires it to be no greater than attachment_count." },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/recognitionAttachment" }, "minItems": 1, "maxItems": 100, "uniqueItems": true },
        "issues": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 50 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
          "then": {
            "properties": {
              "processed_attachment_count": { "minimum": 1 },
              "attachments": {
                "items": { "properties": { "status": { "const": "succeeded" }, "completeness": { "const": "complete" } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
          "then": {
            "properties": {
              "processed_attachment_count": { "minimum": 1 },
              "attachments": {
                "items": { "properties": { "status": { "enum": ["succeeded", "partial"] } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "processed_attachment_count": { "minimum": 1 },
              "attachments": {
                "items": { "properties": { "status": { "enum": ["succeeded", "partial", "failed", "not_executed"] } } },
                "allOf": [
                  {
                    "contains": { "properties": { "status": { "enum": ["failed", "not_executed"] } }, "required": ["status"] },
                    "minContains": 1
                  },
                  {
                    "contains": { "properties": { "status": { "enum": ["succeeded", "partial", "failed"] } }, "required": ["status"] },
                    "minContains": 1
                  }
                ]
              },
              "issues": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "not_executed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "processed_attachment_count": { "const": 0 },
              "pass_count": { "const": 0 },
              "refinement": { "properties": { "status": { "const": "not_applicable" } }, "required": ["status"] },
              "attachments": {
                "items": { "properties": { "status": { "const": "not_executed" }, "completeness": { "const": "unavailable" } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "pass_count": { "enum": [0, 1] },
              "refinement": { "properties": { "status": { "const": "not_applicable" } }, "required": ["status"] }
            }
          }
        },
        {
          "if": { "properties": { "refinement": { "properties": { "status": { "const": "not_applicable" } }, "required": ["status"] } }, "required": ["refinement"] },
          "then": { "properties": { "status": { "enum": ["failed", "not_executed"] }, "pass_count": { "enum": [0, 1] } } }
        },
        {
          "if": { "properties": { "refinement": { "properties": { "status": { "const": "not_needed" } }, "required": ["status"] } }, "required": ["refinement"] },
          "then": {
            "properties": {
              "pass_count": { "const": 1 },
              "refinement": {
                "properties": {
                  "reasons": { "maxItems": 0 },
                  "targeted_fields": { "maxItems": 0 },
                  "attachment_indexes": { "maxItems": 0 },
                  "issues": { "maxItems": 0 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "partial" },
              "refinement": { "properties": { "status": { "enum": ["not_needed", "succeeded"] } }, "required": ["status"] }
            },
            "required": ["status", "refinement"]
          },
          "then": {
            "properties": {
              "attachments": {
                "contains": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "refinement": { "properties": { "status": { "enum": ["succeeded", "partial", "failed"] } }, "required": ["status"] } }, "required": ["refinement"] },
          "then": {
            "properties": {
              "pass_count": { "const": 2 },
              "refinement": {
                "properties": {
                  "reasons": { "minItems": 1 },
                  "targeted_fields": { "minItems": 1 },
                  "attachment_indexes": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "refinement": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] } }, "required": ["refinement"] },
          "then": { "properties": { "status": { "enum": ["succeeded", "partial"] } } }
        },
        {
          "if": { "properties": { "refinement": { "properties": { "status": { "enum": ["partial", "failed"] } }, "required": ["status"] } }, "required": ["refinement"] },
          "then": { "properties": { "status": { "const": "partial" } } }
        }
      ]
    },
    "refinementRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons", "targeted_fields", "attachment_indexes", "issues"],
      "properties": {
        "status": { "enum": ["not_applicable", "not_needed", "succeeded", "partial", "failed"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 20 },
        "targeted_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "merchant", "transaction_time", "order_status", "final_paid_amount", "refund_total",
              "full_name", "normalized_name", "specification", "purchase_quantity", "quantity_unit",
              "nominal_weight_or_volume", "actual_weight_or_volume", "billing_weight", "weight_variance",
              "original_amount", "unit_price", "line_paid_amount", "refund_amount", "production_date",
              "line_status", "item_type", "visibility_status", "visible_item_count"
            ]
          },
          "maxItems": 24
        },
        "attachment_indexes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 99 },
          "maxItems": 100
        },
        "issues": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 20 }
      }
    },
    "recognitionAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_index", "status", "completeness", "limitations"],
      "properties": {
        "attachment_index": { "type": "integer", "minimum": 0, "maximum": 99 },
        "status": { "enum": ["succeeded", "partial", "failed", "not_executed"] },
        "completeness": { "enum": ["complete", "partial", "unavailable"] },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
          "then": { "properties": { "completeness": { "const": "complete" }, "limitations": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
          "then": { "properties": { "completeness": { "const": "partial" }, "limitations": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "properties": { "completeness": { "const": "unavailable" }, "limitations": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "not_executed" } }, "required": ["status"] },
          "then": { "properties": { "completeness": { "const": "unavailable" } } }
        }
      ]
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": {
          "enum": [
            "visible_label",
            "user_text",
            "calculated",
            "reference_database",
            "visual_estimate"
          ]
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "location": { "type": "string", "minLength": 1, "maxLength": 240 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "textFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "string" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "value": { "const": null } }, "required": ["value"] },
          "then": {
            "properties": {
              "confidence": { "const": 0 },
              "calculated": { "const": false },
              "evidence": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "amountFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 9999999999.99 },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "number" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "value": { "const": null } }, "required": ["value"] },
          "then": {
            "properties": {
              "currency": { "type": "null" },
              "confidence": { "const": 0 },
              "calculated": { "const": false },
              "evidence": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "quantityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 9999999999.99 },
        "unit": { "type": ["string", "null"], "maxLength": 40 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "number" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "value": { "const": null } }, "required": ["value"] },
          "then": {
            "properties": {
              "unit": { "type": "null" },
              "confidence": { "const": 0 },
              "calculated": { "const": false },
              "evidence": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "dateFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"], "format": "date", "minLength": 10, "maxLength": 40 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "string" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "value": { "const": null } }, "required": ["value"] },
          "then": {
            "properties": {
              "confidence": { "const": 0 },
              "calculated": { "const": false },
              "evidence": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "booleanFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["boolean", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "boolean" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "value": { "const": null } }, "required": ["value"] },
          "then": {
            "properties": {
              "confidence": { "const": 0 },
              "calculated": { "const": false },
              "evidence": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "countFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "integer" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "value": { "const": null } }, "required": ["value"] },
          "then": {
            "properties": {
              "confidence": { "const": 0 },
              "calculated": { "const": false },
              "evidence": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "orderFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchant",
        "transaction_time",
        "order_status",
        "goods_subtotal",
        "activity_discount",
        "coupon_discount",
        "packaging_fee",
        "delivery_fee",
        "final_paid_amount",
        "refund_total",
        "declared_item_kind_count",
        "recognized_item_kind_count",
        "hidden_item_kind_count",
        "has_unexpanded_items",
        "content_complete"
      ],
      "properties": {
        "merchant": { "$ref": "#/$defs/textFact" },
        "transaction_time": { "$ref": "#/$defs/textFact" },
        "order_status": { "$ref": "#/$defs/textFact" },
        "goods_subtotal": { "$ref": "#/$defs/amountFact" },
        "activity_discount": { "$ref": "#/$defs/amountFact" },
        "coupon_discount": { "$ref": "#/$defs/amountFact" },
        "packaging_fee": { "$ref": "#/$defs/amountFact" },
        "delivery_fee": { "$ref": "#/$defs/amountFact" },
        "final_paid_amount": { "$ref": "#/$defs/amountFact" },
        "refund_total": { "$ref": "#/$defs/amountFact" },
        "declared_item_kind_count": { "$ref": "#/$defs/countFact" },
        "recognized_item_kind_count": { "$ref": "#/$defs/countFact" },
        "hidden_item_kind_count": { "$ref": "#/$defs/countFact" },
        "has_unexpanded_items": { "$ref": "#/$defs/booleanFact" },
        "content_complete": { "$ref": "#/$defs/booleanFact" }
      }
    },
    "itemFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_name",
        "quantity",
        "specification",
        "line_status",
        "item_type",
        "evidence"
      ],
      "properties": {
        "item_name": { "$ref": "#/$defs/textFact" },
        "quantity": { "$ref": "#/$defs/quantityFact" },
        "specification": { "$ref": "#/$defs/textFact" },
        "line_status": { "$ref": "#/$defs/textFact" },
        "item_type": {
          "enum": [
            "food",
            "non_food",
            "fee",
            "service",
            "discount",
            "advertising",
            "recommendation",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "productFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name", "normalized_name", "specification", "purchase_quantity", "quantity_unit",
        "nominal_weight_or_volume", "actual_weight_or_volume", "billing_weight", "weight_variance",
        "original_amount", "unit_price", "line_paid_amount", "refund_amount", "production_date",
        "line_status", "item_type", "visibility_status"
      ],
      "properties": {
        "full_name": { "$ref": "#/$defs/textFact" },
        "normalized_name": { "$ref": "#/$defs/textFact" },
        "specification": { "$ref": "#/$defs/textFact" },
        "purchase_quantity": { "$ref": "#/$defs/quantityFact" },
        "quantity_unit": { "$ref": "#/$defs/textFact" },
        "nominal_weight_or_volume": { "$ref": "#/$defs/quantityFact" },
        "actual_weight_or_volume": { "$ref": "#/$defs/quantityFact" },
        "billing_weight": { "$ref": "#/$defs/quantityFact" },
        "weight_variance": { "$ref": "#/$defs/quantityFact" },
        "original_amount": { "$ref": "#/$defs/amountFact" },
        "unit_price": { "$ref": "#/$defs/amountFact" },
        "line_paid_amount": { "$ref": "#/$defs/amountFact" },
        "refund_amount": { "$ref": "#/$defs/amountFact" },
        "production_date": { "$ref": "#/$defs/dateFact" },
        "line_status": { "$ref": "#/$defs/textFact" },
        "item_type": { "$ref": "#/$defs/textFact" },
        "visibility_status": { "$ref": "#/$defs/textFact" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "products"],
      "properties": {
        "order": { "$ref": "#/$defs/orderFacts" },
        "products": {
          "type": "array",
          "items": { "$ref": "#/$defs/productFacts" },
          "maxItems": 100
        },
        "unresolved_issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxItems": 50
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" }
      }
    },
    "accountingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_index", "full_name"],
      "properties": {
        "product_index": { "type": "integer", "minimum": 0, "maximum": 99 },
        "full_name": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "specification": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "quantity": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 9999999999.99 },
        "quantity_unit": { "type": ["string", "null"], "minLength": 1, "maxLength": 40, "pattern": "\\S" },
        "nominal_weight_or_volume": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] },
        "actual_weight_or_volume": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] },
        "weight_variance": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] },
        "line_paid_amount": { "type": ["number", "null"], "minimum": 0, "maximum": 9999999999.99 },
        "refund_amount": { "type": ["number", "null"], "minimum": 0, "maximum": 9999999999.99 }
      }
    },
    "accountingContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "merchant", "transaction_time", "final_paid_amount", "items", "issues"],
      "properties": {
        "executable": { "type": "boolean" },
        "merchant": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "transaction_time": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "final_paid_amount": { "type": ["number", "null"], "minimum": 0, "maximum": 9999999999.99 },
        "items": {
          "type": "array",
          "description": "Runtime validation requires each product_index to be unique within this array.",
          "items": { "$ref": "#/$defs/accountingItem" },
          "maxItems": 100,
          "uniqueItems": true
        },
        "issues": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 100 }
      },
      "allOf": [
        {
          "if": { "properties": { "executable": { "const": true } }, "required": ["executable"] },
          "then": { "properties": { "final_paid_amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 9999999999.99 } } }
        }
      ]
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_index", "food_name", "quantity", "quantity_unit"],
      "properties": {
        "product_index": { "type": "integer", "minimum": 0, "maximum": 99 },
        "food_name": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "quantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 9999999999.99 },
        "quantity_unit": { "type": ["string", "null"], "minLength": 1, "maxLength": 40, "pattern": "\\S" },
        "specification": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "weight_or_volume": { "oneOf": [{ "$ref": "#/$defs/measurement" }, { "type": "null" }] },
        "production_date": { "type": ["string", "null"], "format": "date", "minLength": 10, "maxLength": 10 }
      }
    },
    "inventoryExcludedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_index", "name", "reason"],
      "properties": {
        "product_index": { "type": ["integer", "null"], "minimum": 0, "maximum": 99 },
        "name": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
      }
    },
    "inventoryContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "items", "excluded_items", "issues"],
      "properties": {
        "executable": { "type": "boolean" },
        "items": {
          "type": "array",
          "description": "Runtime validation requires each product_index to be unique within this array.",
          "items": { "$ref": "#/$defs/inventoryItem" },
          "maxItems": 100,
          "uniqueItems": true
        },
        "excluded_items": { "type": "array", "items": { "$ref": "#/$defs/inventoryExcludedItem" }, "maxItems": 100 },
        "issues": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 100 }
      },
      "allOf": [
        {
          "if": { "properties": { "executable": { "const": true } }, "required": ["executable"] },
          "then": { "properties": { "items": { "minItems": 1 } } }
        }
      ]
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_id", "selected_scopes"],
      "properties": {
        "preview_id": { "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
        "selected_scopes": {
          "type": "array",
          "items": { "enum": ["accounting", "inventory"] },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    }
  }
}
