{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.openclaw.invalid/schemas/image-intake-router.v2.json",
  "title": "Image Intake Router v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preview_state",
    "source",
    "facts",
    "expense_projection",
    "diet_projection",
    "quality",
    "recognition_run"
  ],
  "properties": {
    "schema_version": { "const": "image-intake-router.v2.1" },
    "preview_state": { "enum": ["draft", "awaiting_confirmation", "executing", "consumed"] },
    "source": { "$ref": "#/$defs/source" },
    "recognition_run": { "$ref": "#/$defs/recognitionRun" },
    "facts": { "$ref": "#/$defs/facts" },
    "expense_projection": {
      "oneOf": [
        { "$ref": "#/$defs/expenseProjection" },
        { "type": "null" }
      ]
    },
    "diet_projection": {
      "oneOf": [
        { "$ref": "#/$defs/dietProjection" },
        { "type": "null" }
      ]
    },
    "quality": { "$ref": "#/$defs/quality" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "quality": {
            "properties": {
              "fact_set_status": { "const": "complete" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "facts": {
            "properties": {
              "unresolved_issues": { "maxItems": 0 }
            }
          },
          "quality": {
            "properties": {
              "issues": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recognition_run": {
            "properties": {
              "status": { "enum": ["failed", "not_executed"] }
            },
            "required": ["status"]
          }
        },
        "required": ["recognition_run"]
      },
      "then": {
        "properties": {
          "expense_projection": { "type": "null" },
          "diet_projection": { "type": "null" },
          "quality": {
            "properties": {
              "fact_set_status": { "const": "unavailable" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_count", "has_user_text"],
      "properties": {
        "image_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "has_user_text": { "type": "boolean" }
      }
    },
    "recognitionRun": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mandatory pre-projection runtime validation: attachment_count equals source.image_count and attachments.length; attachments contain exactly one record for each unique contiguous attachment_index from 0 through attachment_count - 1; processed_attachment_count is derived from records that entered visual capability (all statuses except not_executed) and must not exceed attachment_count. Fail closed before any projection when any invariant is violated.",
      "required": ["status", "method", "attachment_count", "processed_attachment_count", "attachments", "issues"],
      "properties": {
        "status": { "enum": ["succeeded", "partial", "failed", "not_executed"] },
        "method": { "enum": ["native_vision", "media_understanding"] },
        "attachment_count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "processed_attachment_count": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Derived from attachment records that entered visual capability (not not_executed). Runtime validation requires it to be no greater than attachment_count." },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/recognitionAttachment" }, "minItems": 1, "maxItems": 100, "uniqueItems": true },
        "issues": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 50 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
          "then": {
            "properties": {
              "processed_attachment_count": { "minimum": 1 },
              "attachments": {
                "items": { "properties": { "status": { "const": "succeeded" }, "completeness": { "const": "complete" } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
          "then": {
            "properties": {
              "processed_attachment_count": { "minimum": 1 },
              "attachments": {
                "items": { "properties": { "status": { "enum": ["succeeded", "partial", "failed"] } } },
                "contains": { "properties": { "status": { "enum": ["partial", "failed"] } }, "required": ["status"] },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "processed_attachment_count": { "minimum": 1 },
              "attachments": {
                "items": { "properties": { "status": { "enum": ["succeeded", "partial", "failed"] } } },
                "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
                "minContains": 1
              },
              "issues": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "not_executed" } }, "required": ["status"] },
          "then": {
            "properties": {
              "processed_attachment_count": { "const": 0 },
              "attachments": {
                "items": { "properties": { "status": { "const": "not_executed" }, "completeness": { "const": "unavailable" } } }
              }
            }
          }
        }
      ]
    },
    "recognitionAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_index", "status", "completeness", "limitations"],
      "properties": {
        "attachment_index": { "type": "integer", "minimum": 0, "maximum": 99 },
        "status": { "enum": ["succeeded", "partial", "failed", "not_executed"] },
        "completeness": { "enum": ["complete", "partial", "unavailable"] },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
          "then": { "properties": { "completeness": { "const": "complete" }, "limitations": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
          "then": { "properties": { "completeness": { "const": "partial" }, "limitations": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "properties": { "completeness": { "const": "unavailable" }, "limitations": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "not_executed" } }, "required": ["status"] },
          "then": { "properties": { "completeness": { "const": "unavailable" } } }
        }
      ]
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": {
          "enum": [
            "visible_label",
            "user_text",
            "calculated",
            "reference_database",
            "visual_estimate"
          ]
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "location": { "type": "string", "minLength": 1, "maxLength": 240 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "textFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "string" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "amountFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 9999999999.99 },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "number" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "quantityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 9999999999.99 },
        "unit": { "type": ["string", "null"], "maxLength": 40 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "number" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "dateFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"], "format": "date", "minLength": 10, "maxLength": 40 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "string" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "booleanFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["boolean", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "boolean" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "countFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "calculated", "evidence"],
      "properties": {
        "value": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" }, "maxItems": 20 }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "integer" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "orderFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchant",
        "transaction_time",
        "order_status",
        "goods_subtotal",
        "activity_discount",
        "coupon_discount",
        "packaging_fee",
        "delivery_fee",
        "final_paid_amount",
        "refund_total",
        "declared_item_kind_count",
        "recognized_item_kind_count",
        "hidden_item_kind_count",
        "has_unexpanded_items",
        "content_complete"
      ],
      "properties": {
        "merchant": { "$ref": "#/$defs/textFact" },
        "transaction_time": { "$ref": "#/$defs/textFact" },
        "order_status": { "$ref": "#/$defs/textFact" },
        "goods_subtotal": { "$ref": "#/$defs/amountFact" },
        "activity_discount": { "$ref": "#/$defs/amountFact" },
        "coupon_discount": { "$ref": "#/$defs/amountFact" },
        "packaging_fee": { "$ref": "#/$defs/amountFact" },
        "delivery_fee": { "$ref": "#/$defs/amountFact" },
        "final_paid_amount": { "$ref": "#/$defs/amountFact" },
        "refund_total": { "$ref": "#/$defs/amountFact" },
        "declared_item_kind_count": { "$ref": "#/$defs/countFact" },
        "recognized_item_kind_count": { "$ref": "#/$defs/countFact" },
        "hidden_item_kind_count": { "$ref": "#/$defs/countFact" },
        "has_unexpanded_items": { "$ref": "#/$defs/booleanFact" },
        "content_complete": { "$ref": "#/$defs/booleanFact" }
      }
    },
    "auxiliaryAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "amount"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
        "amount": { "$ref": "#/$defs/amountFact" }
      }
    },
    "itemFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_name",
        "quantity",
        "specification",
        "line_status",
        "item_type",
        "evidence"
      ],
      "properties": {
        "item_name": { "$ref": "#/$defs/textFact" },
        "quantity": { "$ref": "#/$defs/quantityFact" },
        "specification": { "$ref": "#/$defs/textFact" },
        "line_status": { "$ref": "#/$defs/textFact" },
        "item_type": {
          "enum": [
            "food",
            "non_food",
            "fee",
            "service",
            "discount",
            "advertising",
            "recommendation",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "productFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name", "normalized_name", "specification", "purchase_quantity", "quantity_unit",
        "nominal_weight_or_volume", "actual_weight_or_volume", "billing_weight", "weight_variance",
        "original_amount", "unit_price", "line_paid_amount", "refund_amount", "production_date",
        "line_status", "item_type", "visibility_status"
      ],
      "properties": {
        "full_name": { "$ref": "#/$defs/textFact" },
        "normalized_name": { "$ref": "#/$defs/textFact" },
        "specification": { "$ref": "#/$defs/textFact" },
        "purchase_quantity": { "$ref": "#/$defs/quantityFact" },
        "quantity_unit": { "$ref": "#/$defs/textFact" },
        "nominal_weight_or_volume": { "$ref": "#/$defs/quantityFact" },
        "actual_weight_or_volume": { "$ref": "#/$defs/quantityFact" },
        "billing_weight": { "$ref": "#/$defs/quantityFact" },
        "weight_variance": { "$ref": "#/$defs/quantityFact" },
        "original_amount": { "$ref": "#/$defs/amountFact" },
        "unit_price": { "$ref": "#/$defs/amountFact" },
        "line_paid_amount": { "$ref": "#/$defs/amountFact" },
        "refund_amount": { "$ref": "#/$defs/amountFact" },
        "production_date": { "$ref": "#/$defs/dateFact" },
        "line_status": { "$ref": "#/$defs/textFact" },
        "item_type": { "$ref": "#/$defs/textFact" },
        "visibility_status": { "$ref": "#/$defs/textFact" }
      }
    },
    "fieldMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "calculated", "evidence"],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "calculated": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRecord" }, "maxItems": 20 }
      }
    },
    "expenseLineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name", "normalized_name", "specification", "purchase_quantity", "quantity_unit",
        "nominal_weight_or_volume", "actual_weight_or_volume", "billing_weight", "weight_variance",
        "original_amount", "unit_price", "line_paid_amount", "refund_amount", "production_date",
        "line_status", "item_type", "visibility_status", "field_metadata"
      ],
      "properties": {
        "full_name": { "$ref": "#/$defs/textFact" },
        "normalized_name": { "$ref": "#/$defs/textFact" },
        "specification": { "$ref": "#/$defs/textFact" },
        "purchase_quantity": { "$ref": "#/$defs/quantityFact" },
        "quantity_unit": { "$ref": "#/$defs/textFact" },
        "nominal_weight_or_volume": { "$ref": "#/$defs/quantityFact" },
        "actual_weight_or_volume": { "$ref": "#/$defs/quantityFact" },
        "billing_weight": { "$ref": "#/$defs/quantityFact" },
        "weight_variance": { "$ref": "#/$defs/quantityFact" },
        "original_amount": { "$ref": "#/$defs/amountFact" },
        "unit_price": { "$ref": "#/$defs/amountFact" },
        "line_paid_amount": { "$ref": "#/$defs/amountFact" },
        "refund_amount": { "$ref": "#/$defs/amountFact" },
        "production_date": { "$ref": "#/$defs/dateFact" },
        "line_status": { "$ref": "#/$defs/textFact" },
        "item_type": { "$ref": "#/$defs/textFact" },
        "visibility_status": { "$ref": "#/$defs/textFact" },
        "field_metadata": { "$ref": "#/$defs/fieldMetadata" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "products"],
      "properties": {
        "order": { "$ref": "#/$defs/orderFacts" },
        "products": {
          "type": "array",
          "items": { "$ref": "#/$defs/productFacts" },
          "maxItems": 100
        },
        "unresolved_issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxItems": 50
        }
      }
    },
    "expenseProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "amount",
        "category_id",
        "occurred_at",
        "source_kind",
        "merchant",
        "note",
        "issues"
      ],
      "properties": {
        "executable": { "type": "boolean" },
        "amount": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 9999999999.99 },
        "category_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
        "occurred_at": {
          "type": ["string", "null"],
          "minLength": 20,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "source_kind": { "const": "image" },
        "merchant": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
        "note": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxItems": 50
        },
        "line_items": { "type": "array", "items": { "$ref": "#/$defs/expenseLineItem" }, "minItems": 1, "maxItems": 100 },
        "detail_completeness": { "enum": ["complete", "partial", "unavailable"] },
        "omitted_item_count": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      },
      "allOf": [
        {
          "if": { "properties": { "executable": { "const": false } } },
          "then": {
            "properties": {
              "amount": { "type": "null" },
              "category_id": { "type": "null" },
              "occurred_at": { "type": "null" },
              "merchant": { "type": "null" },
              "note": { "type": "null" },
              "issues": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "executable": { "const": true } } },
          "then": {
            "properties": {
              "amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 9999999999.99 },
              "category_id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "occurred_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 40,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              }
            }
          }
        }
      ]
    },
    "labelNutrition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "energy_kj": { "type": ["number", "null"], "minimum": 0 },
        "calories_kcal": { "type": ["number", "null"], "minimum": 0 },
        "protein_g": { "type": ["number", "null"], "minimum": 0 },
        "fat_g": { "type": ["number", "null"], "minimum": 0 },
        "carbohydrate_g": { "type": ["number", "null"], "minimum": 0 },
        "sodium_mg": { "type": ["number", "null"], "minimum": 0 },
        "fiber_g": { "type": ["number", "null"], "minimum": 0 },
        "sugar_g": { "type": ["number", "null"], "minimum": 0 },
        "saturated_fat_g": { "type": ["number", "null"], "minimum": 0 },
        "hydration_ml": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "nutritionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_name", "serving_basis", "nutrition", "source_text", "source_grade"],
      "properties": {
        "normalized_name": { "type": "string", "minLength": 1 },
        "brand": { "type": "string", "minLength": 1 },
        "product_key": { "type": "string", "minLength": 1 },
        "serving_basis": { "enum": ["per_100g", "per_100ml", "per_serving"] },
        "nutrition": { "$ref": "#/$defs/labelNutrition" },
        "source_text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source_grade": { "enum": ["A", "B", "C", "D", "unknown"] }
      }
    },
    "packageHierarchyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "per_parent": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 }
      },
      "anyOf": [
        { "required": ["quantity"] },
        { "required": ["per_parent"] }
      ]
    },
    "pantryAddItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "food_name", "quantity", "unit", "source_text"],
      "properties": {
        "action": { "const": "add" },
        "food_name": { "type": "string", "minLength": 1 },
        "normalized_name": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit": {
          "enum": [
            "g", "gram", "grams", "ml", "milliliter", "milliliters",
            "piece", "pieces", "portion", "portions", "pack", "packs"
          ]
        },
        "package_count": { "type": "number", "exclusiveMinimum": 0 },
        "quantity_per_package": { "type": "number", "exclusiveMinimum": 0 },
        "package_unit": { "enum": ["g", "ml"] },
        "display_quantity": { "type": "number", "exclusiveMinimum": 0 },
        "display_unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "base_quantity_per_display_unit": { "type": "number", "exclusiveMinimum": 0 },
        "package_hierarchy": {
          "type": "array",
          "items": { "$ref": "#/$defs/packageHierarchyItem" },
          "minItems": 1,
          "maxItems": 4
        },
        "source_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\r\\n]+$"
        },
        "expiry_date": { "type": "string", "format": "date", "maxLength": 16384 },
        "expires_at": { "type": ["string", "null"], "maxLength": 16384 },
        "nutrition_profile": { "$ref": "#/$defs/nutritionProfile" }
      },
      "dependentRequired": {
        "display_quantity": ["display_unit", "base_quantity_per_display_unit"],
        "display_unit": ["display_quantity", "base_quantity_per_display_unit"],
        "base_quantity_per_display_unit": ["display_quantity", "display_unit"],
        "package_count": ["quantity_per_package", "package_unit"],
        "quantity_per_package": ["package_count", "package_unit"],
        "package_unit": ["package_count", "quantity_per_package"]
      },
      "oneOf": [
        { "required": ["expiry_date"], "not": { "required": ["expires_at"] } },
        { "required": ["expires_at"], "not": { "required": ["expiry_date"] } }
      ]
    },
    "excludedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_name", "status", "reason", "evidence"],
      "properties": {
        "item_name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "status": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "maxItems": 20
        }
      }
    },
    "uncertainItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_name", "status", "reason", "evidence"],
      "properties": {
        "item_name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "status": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "maxItems": 20
        }
      }
    },
    "itemAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_index", "order_status", "evidence"],
      "properties": {
        "item_index": { "type": "integer", "minimum": 0 },
        "order_status": { "enum": ["purchased_and_received"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "dietAdapterPayloadItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_product_index", "quantity", "unit", "display_quantity", "display_unit"],
      "properties": {
        "source_product_index": { "type": "integer", "minimum": 0, "maximum": 999999 },
        "quantity": { "type": "number", "minimum": 0, "maximum": 9999999999.99 },
        "unit": { "enum": ["g", "ml", "piece"] },
        "display_quantity": { "type": ["number", "null"], "minimum": 0, "maximum": 9999999999.99 },
        "display_unit": { "type": ["string", "null"], "maxLength": 40 }
      }
    },
    "dietProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "item_audit", "excluded_items", "uncertain_items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/pantryAddItem" },
          "maxItems": 100
        },
        "item_audit": {
          "type": "array",
          "items": { "$ref": "#/$defs/itemAudit" },
          "maxItems": 100
        },
        "excluded_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/excludedItem" },
          "maxItems": 100
        },
        "uncertain_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/uncertainItem" },
          "maxItems": 100
        },
        "executable": { "type": "boolean" },
        "business_products": { "type": "array", "items": { "$ref": "#/$defs/productFacts" }, "maxItems": 100 },
        "adapter_payload": { "type": "array", "items": { "$ref": "#/$defs/dietAdapterPayloadItem" }, "maxItems": 100 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_capability", "fact_set_status", "issues"],
      "properties": {
        "visual_capability": { "enum": ["available", "unavailable"] },
        "fact_set_status": { "enum": ["complete", "partial", "unavailable"] },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxItems": 50
        }
      }
    }
  }
}
